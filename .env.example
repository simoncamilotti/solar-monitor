# Local environment. Copy to .env (ignored by git); the defaults match docker-compose.yml.

# --- docker-compose -----------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Application database; the e2e database is `<name>_e2e`.
POSTGRES_DB=solar-monitor
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
MAILPIT_SMTP_PORT=1025
# Mailpit web UI: every e-mail sent locally lands here.
MAILPIT_UI_PORT=8025

# --- API (apps/api, validated by src/env.ts) ----------------------------------------------
# The API refuses to boot unless the time zone is UTC.
TZ=Etc/UTC
PORT=3000
# development | test | production
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solar-monitor
# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:4200
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/solar-monitor
KEYCLOAK_CLIENT_ID=solar-monitor-web

# Enphase API (https://developer-v4.enphase.com)
ENPHASE_CLIENT_ID=<replace_me>
ENPHASE_CLIENT_SECRET=<replace_me>
ENPHASE_API_KEY=<replace_me>
ENPHASE_REDIRECT_URI=http://localhost:3000/api/enphase/callback
# 32-byte key, hex-encoded: `openssl rand -hex 32`.
ENPHASE_TOKEN_ENCRYPTION_KEY=<replace_me>

# --- E2E tests ----------------------------------------------------------------------------
# Keycloak user of `pnpm nx e2e-local api-e2e`.
KEYCLOAK_TEST_USER=<replace_me>
KEYCLOAK_TEST_PASSWORD=<replace_me>
