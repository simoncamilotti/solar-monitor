{
  "name": "core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/core/src",
  "projectType": "library",
  "tags": ["scope:api", "type:lib"],
  "// targets": "to see all targets run: nx show project core --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "cwd": "libs/api/core",
        "parallel": false
      },
      "cache": true,
      "inputs": ["default", "^production", { "externalDependencies": ["typescript"] }]
    }
  }
}
