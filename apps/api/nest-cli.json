{
  "$schema": "https://json.schemastore.org/nest-cli",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": {
        "extensions": [".ts", ".tsx"]
      }
    },
    "typeCheck": false,
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "swagger/**/*",
        "outDir": "dist"
      }
    ]
  }
}
