generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A person known by the identity provider, created at their first authenticated request.
model User {
  id        String   @id @default(uuid())
  /// `sub` claim of the OIDC token: stable identifier at the identity provider.
  subject   String   @unique
  email     String
  name      String
  /// BCP 47 language tag, e.g. `fr` or `en`.
  locale    String   @default("fr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SyncSchedule {
  id        String   @id @default("default")
  syncTime  String   @default("02:00")
  updatedAt DateTime @updatedAt
}

model EnphaseToken {
  id           String   @id @default(uuid())
  systemId     Int      @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lifetimeData EnphaseLifetimeData[]
}

model EnphaseLifetimeData {
  id   String   @id @default(uuid())
  date DateTime @db.Date

  whProduced Int
  whConsumed Int
  whExported Int
  whImported Int

  createdAt DateTime @default(now())

  EnphaseToken   EnphaseToken @relation(fields: [enphaseTokenId], references: [id])
  enphaseTokenId String

  @@unique([date, enphaseTokenId])
  @@index([date])
}
