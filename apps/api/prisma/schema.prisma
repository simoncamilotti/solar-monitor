generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A person known by the identity provider, created at their first authenticated request.
model User {
  id        String   @id @default(uuid())
  /// `sub` claim of the OIDC token: stable identifier at the identity provider.
  subject   String   @unique
  email     String
  name      String
  /// BCP 47 language tag, e.g. `fr` or `en`.
  locale    String   @default("fr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SyncSchedule {
  id        String   @id @default("default")
  syncTime  String   @default("02:00")
  updatedAt DateTime @updatedAt
}

model EnphaseToken {
  id           String   @id @default(uuid())
  systemId     Int      @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lifetimeData EnphaseLifetimeData[]
}

model EnphaseLifetimeData {
  id   String   @id @default(uuid())
  date DateTime @db.Date

  whProduced Int
  whConsumed Int
  whExported Int
  whImported Int

  createdAt DateTime @default(now())

  EnphaseToken   EnphaseToken @relation(fields: [enphaseTokenId], references: [id])
  enphaseTokenId String

  @@unique([date, enphaseTokenId])
  @@index([date])
}

/// Who sets the price of a kWh: the supplier the household buys from, or the buyer of its surplus.
enum TariffKind {
  purchase
  feedIn
}

/// Price of one kWh from a given day on, until the next tariff of the same kind.
model Tariff {
  id            String     @id @default(uuid())
  kind          TariffKind
  /// Euros per kWh, exact: a float would drift once multiplied by years of kWh.
  pricePerKwh   Decimal    @db.Decimal(8, 5)
  /// First day the price applies, stored at midnight UTC.
  effectiveFrom DateTime   @db.Date
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([kind, effectiveFrom])
}

/// The household's installation: a single row, like `SyncSchedule`.
model Installation {
  id        String   @id @default("default")
  /// Total cost in euros, to measure the return on investment. Unknown until entered.
  cost      Decimal? @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
}

/// A named range of days, both bounds included, saved to compare or display it again.
model DateRange {
  id        String   @id @default(uuid())
  name      String   @unique
  /// First and last day of the range, stored at midnight UTC.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
