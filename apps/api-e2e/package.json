{
  "name": "@repo/api-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "nx": {
    "name": "api-e2e",
    "tags": [
      "type:e2e",
      "platform:node"
    ],
    "implicitDependencies": [
      "api"
    ],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config vitest.e2e.config.ts",
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build",
          "api:build"
        ],
        "parallelism": false
      }
    }
  },
  "devDependencies": {
    "@repo/e2e-support": "workspace:*",
    "vitest": "catalog:"
  }
}
