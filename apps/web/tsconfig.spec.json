{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/vitest",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["vitest/globals", "vite/client", "node"]
  },
  "include": [
    "vite.config.ts",
    "runtime-config.plugin.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test/**/*.ts",
    "src/test/**/*.tsx",
    "src/**/*.json"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
