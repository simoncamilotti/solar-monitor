{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "eslint-plugin-import",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "typescript-eslint",
        "@repo/workspace-plugin"
      ],
      "ignore": ["config/web/config.example.js"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/instrumentation.ts", "src/generate-openapi.ts", "scripts/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/web": {
      "ignore": ["src/window.d.ts"]
    },
    "apps/web-e2e": {
      "playwright": false,
      "entry": ["playwright.config.ts", "src/**/*.e2e.ts"]
    },
    "apps/api-e2e": {
      "entry": ["src/**/*.spec.ts", "src/support/*.ts"]
    },
    "tools/workspace-plugin": {
      "entry": ["src/generators/*/*.ts"]
    }
  }
}
