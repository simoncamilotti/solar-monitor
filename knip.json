{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "eslint-plugin-import",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "typescript-eslint",
        "@repo/workspace-plugin"
      ]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/instrumentation.ts", "src/generate-openapi.ts", "scripts/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/web-e2e": {
      "playwright": false,
      "entry": ["playwright.config.ts", "src/**/*.e2e.ts"]
    },
    "apps/api-e2e": {
      "entry": ["src/**/*.spec.ts", "src/support/*.ts"]
    },
    "tools/workspace-plugin": {
      "entry": ["src/generators/*/*.ts"]
    },
    "libs/shared/api-client": {
      "entry": ["scripts/index-mocks.mjs"],
      "ignoreDependencies": ["@tanstack/react-query", "@faker-js/faker", "msw"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "libs/web/ui": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts"]
    }
  },
  "ignore": ["apps/web/src/route-tree.gen.ts"]
}
